# Salin file ini menjadi .env.local lalu isi nilainya.
# Di Vercel: Project Settings → Environment Variables.

# ── Database ─────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas sudah mendukung transaksi)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Opsional, default "cibuluberdaya"
MONGODB_DB=cibuluberdaya

# ── Pembayaran (Midtrans sandbox) ────────────────────────
# https://dashboard.sandbox.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
# Opsional: "midtrans" atau "simulasi". Default: midtrans bila server key diisi.
# PAYMENT_PROVIDER=simulasi

# ── Ongkir ───────────────────────────────────────────────
# Saat ini hanya "simulasi" (tarif simulasi dari Jatiasih, Bekasi)
SHIPPING_PROVIDER=simulasi

# ── Admin ────────────────────────────────────────────────
# Password untuk /admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Minimal 32 karakter acak, mis. hasil: openssl rand -hex 32
SESSION_SECRET=

# ── Cron (batalkan pesanan yang tidak dibayar > 24 jam) ──
# Vercel otomatis mengirim "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
